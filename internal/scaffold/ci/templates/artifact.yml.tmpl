# The AMSL build integration currently targets Docker Buildx, which does not match the required Podman reference runner.
# Keep this job composition explicit until a separately qualified upstream alternative exists.
# Generated job fragment only. Root workflow owns triggers, trusted-ref guards,
# required-check wiring, release authority, and publication permissions.
jobs:
  build-artifact:
    name: Build and scan OCI artifact
    runs-on: ${{ inputs.artifact_runner }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - name: Checkout reviewed source
        run: git checkout --detach "$GITHUB_SHA"
      - name: Validate build tools and target
        env:
          AMOS_TARGET_PLATFORM: ${{ inputs.artifact_platform }}
        run: |
          set -euo pipefail
          case "$AMOS_TARGET_PLATFORM" in linux/amd64|linux/arm64) ;; *) echo "unsupported single target platform" >&2; exit 2 ;; esac
          command -v podman >/dev/null
          command -v syft >/dev/null
          command -v grype >/dev/null
          command -v trivy >/dev/null
          printf '%s\n' "$AMOS_TARGET_PLATFORM" > .amos-target-platform
      - name: Build single-platform OCI image
        env:
          AMOS_TARGET_PLATFORM: ${{ inputs.artifact_platform }}
          AMOS_IMAGE_TAG: amos:ci-${{ github.sha }}
        run: |
          set -euo pipefail
          podman build --pull=always --format=oci --platform "$AMOS_TARGET_PLATFORM" \
            --file .amos/Containerfile --tag "$AMOS_IMAGE_TAG" .
          test "$(podman image inspect --format '{{.Os}}/{{.Architecture}}' "$AMOS_IMAGE_TAG")" = "$AMOS_TARGET_PLATFORM"
          test "$(podman image inspect --format '{{.Config.User}}' "$AMOS_IMAGE_TAG")" = "65532:65532"
      - name: Record image history
        env:
          AMOS_IMAGE_TAG: amos:ci-${{ github.sha }}
        run: podman image history --no-trunc "$AMOS_IMAGE_TAG" > image-history.txt
      - name: Generate SBOM
        env:
          AMOS_IMAGE_TAG: amos:ci-${{ github.sha }}
        run: syft "$AMOS_IMAGE_TAG" --output cyclonedx-json=sbom.cdx.json
      - name: Block vulnerable or secret-bearing images
        env:
          AMOS_IMAGE_TAG: amos:ci-${{ github.sha }}
        run: |
          set -euo pipefail
          grype "$AMOS_IMAGE_TAG" --fail-on high
          trivy image --scanners secret --severity HIGH,CRITICAL --exit-code 1 "$AMOS_IMAGE_TAG"
