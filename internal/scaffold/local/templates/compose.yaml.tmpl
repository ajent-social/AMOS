name: {{.App}}
services:
  database:
    image: {{.Image}}
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${AMOS_DB_NAME:?set AMOS_DB_NAME in .env.local}
      POSTGRES_USER: ${AMOS_DB_MIGRATION_USER:?set AMOS_DB_MIGRATION_USER in .env.local}
      "POSTGRES_PASSWORD": ${AMOS_DB_MIGRATION_PASSWORD:?set AMOS_DB_MIGRATION_PASSWORD in .env.local}
      POSTGRES_INITDB_ARGS: --auth-host=scram-sha-256
      POSTGRES_HOST_AUTH_METHOD: scram-sha-256
      AMOS_DB_RUNTIME_USER: ${AMOS_DB_RUNTIME_USER:?set AMOS_DB_RUNTIME_USER in .env.local}
      "AMOS_DB_RUNTIME_PASSWORD": ${AMOS_DB_RUNTIME_PASSWORD:?set AMOS_DB_RUNTIME_PASSWORD in .env.local}
    ports:
      - "127.0.0.1:${AMOS_DB_PORT:-55432}:5432"
    volumes:
      - {{.App}}-postgres-data:/var/lib/postgresql/data
      - ./db-init-roles.sh:/docker-entrypoint-initdb.d/10-amos-roles.sh:ro
    networks:
      - {{.App}}-database
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 2s
      timeout: 3s
      retries: 30
volumes:
  {{.App}}-postgres-data:
    name: {{.App}}-postgres-data
networks:
  {{.App}}-database:
    name: {{.App}}-database
    internal: true
