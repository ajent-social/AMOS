{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amos.dev/schemas/business-extension-v1.json",
  "title": "AMOS business extension registration descriptor v1",
  "description": "Strict design-time descriptor. It does not implement runtime composition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "operations"],
  "properties": {
    "contract": {"const": "amos-contract-v1"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "method", "path", "inputType", "outputType", "permissions", "entitlements", "assurance", "sideEffect", "idempotency", "mcp", "features"],
      "properties": {
        "operationId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}, "minLength": 3, "maxLength": 120},
        "method": {"enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]},
        "path": {"type": "string", "pattern": "^/(?:[A-Za-z0-9_~-][A-Za-z0-9._~-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._~-]*)(?:/(?:[A-Za-z0-9_~-][A-Za-z0-9._~-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._~-]*))*(?:/\\*)?$", "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}, "minLength": 2, "maxLength": 512},
        "inputType": {"$ref": "#/$defs/typeName"},
        "outputType": {"$ref": "#/$defs/typeName"},
        "permissions": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"$ref": "#/$defs/requirementName"}},
        "entitlements": {"type": "array", "uniqueItems": true, "maxItems": 64, "items": {"$ref": "#/$defs/requirementName"}},
        "assurance": {"enum": ["aal1", "aal2", "aal3"]},
        "sideEffect": {"enum": ["read", "write", "external"]},
        "idempotency": {"enum": ["required", "natural", "forbidden"]},
        "mcp": {"enum": ["never", "eligible", "challenge"]},
        "features": {"type": "array", "uniqueItems": true, "maxItems": 16, "items": {"enum": ["typed-json", "server-rendered-ui"]}}
      }
    },
    "typeName": {"type": "string", "pattern": "^(?:[A-Z][A-Za-z0-9]*|[a-z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)+)$", "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}, "minLength": 1, "maxLength": 160},
    "requirementName": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.:_-][a-z0-9]+)*$", "not": {"pattern": "[\\u0000-\\u001f\\u007f]"}, "minLength": 2, "maxLength": 120}
  }
}
