{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amos.dev/schemas/mcp-mapping-v1.json",
  "title": "AMOS MCP operation mapping contract v1",
  "description": "Strict design-time mapping. Structural bounds are enforced here; cross-field policy and input-reference rules require the documented semantic validator. This schema does not implement runtime MCP serving or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "operations"
  ],
  "properties": {
    "contract": {
      "const": "amos-mcp-mapping-v1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "toolName",
        "description",
        "inputSchema",
        "policy"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 120
        },
        "toolName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "inputSchema": {
          "$ref": "#/$defs/inputSchema"
        },
        "policy": {
          "$ref": "#/$defs/policy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "properties": {
                  "workspaceSelection": {
                    "const": "explicit_member"
                  }
                },
                "required": [
                  "workspaceSelection"
                ]
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "properties": {
              "inputSchema": {
                "properties": {
                  "properties": {
                    "required": [
                      "workspaceId"
                    ]
                  },
                  "required": {
                    "contains": {
                      "const": "workspaceId"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "permissions",
        "entitlements",
        "minimumAssurance",
        "sideEffect",
        "idempotency",
        "workspaceSelection",
        "resourceSelection"
      ],
      "properties": {
        "exposure": {
          "enum": [
            "never",
            "eligible",
            "challenge"
          ]
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/requirementName"
          }
        },
        "entitlements": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/requirementName"
          }
        },
        "minimumAssurance": {
          "enum": [
            "aal1",
            "aal2",
            "aal3"
          ]
        },
        "sideEffect": {
          "enum": [
            "read",
            "write",
            "external"
          ]
        },
        "idempotency": {
          "enum": [
            "required",
            "natural",
            "forbidden"
          ]
        },
        "workspaceSelection": {
          "enum": [
            "active_principal",
            "explicit_member"
          ]
        },
        "resourceSelection": {
          "enum": [
            "none",
            "request_bound"
          ]
        },
        "resourceField": {
          "type": "string",
          "pattern": "^/[A-Za-z][A-Za-z0-9_]*$",
          "maxLength": 96
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exposure": {
                "enum": [
                  "eligible",
                  "challenge"
                ]
              }
            },
            "required": [
              "exposure"
            ]
          },
          "then": {
            "properties": {
              "permissions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resourceSelection": {
                "const": "request_bound"
              }
            },
            "required": [
              "resourceSelection"
            ]
          },
          "then": {
            "required": [
              "resourceField"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resourceSelection": {
                "const": "none"
              }
            },
            "required": [
              "resourceSelection"
            ]
          },
          "then": {
            "not": {
              "required": [
                "resourceField"
              ]
            }
          }
        }
      ]
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]{0,63}$"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "number",
            "array"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "format": {
          "enum": [
            "date-time",
            "email",
            "uuid"
          ]
        },
        "enum": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "items": {
          "$ref": "#/$defs/scalar"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "maxLength"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "minItems"
                  ]
                },
                {
                  "required": [
                    "maxItems"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "integer",
                  "number"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "minimum",
              "maximum"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minLength"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "minItems"
                  ]
                },
                {
                  "required": [
                    "maxItems"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "format"
                  ]
                },
                {
                  "required": [
                    "minLength"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                },
                {
                  "required": [
                    "minItems"
                  ]
                },
                {
                  "required": [
                    "maxItems"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "minItems",
              "maxItems",
              "items"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "format"
                  ]
                },
                {
                  "required": [
                    "minLength"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "number"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "format": {
          "enum": [
            "date-time",
            "email",
            "uuid"
          ]
        },
        "enum": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "maxLength"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "integer",
                  "number"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "minimum",
              "maximum"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minLength"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "format"
                  ]
                },
                {
                  "required": [
                    "minLength"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "requirementName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.:_-][a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 120
    }
  }
}
