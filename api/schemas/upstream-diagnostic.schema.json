{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amos.dev/schemas/upstream-diagnostic-v1.json",
  "title": "AMOS public diagnostic v1 (design-only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry",
    "window",
    "components",
    "metrics",
    "errors"
  ],
  "properties": {
    "schema": {
      "const": "amos-public-diagnostic-v1"
    },
    "registry": {
      "const": "amos-public-diagnostic-registry-v1"
    },
    "window": {
      "const": "24h"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "public_baseline",
          "source_manifest_sha256"
        ],
        "properties": {
          "id": {
            "const": "amos.http-observability"
          },
          "public_baseline": {
            "const": "amos.http-observability.v1"
          },
          "source_manifest_sha256": {
            "const": "40020920667a6ff56650b4d5e792356ca6f522b3a0e5c729f68074a6053dbdd3"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "bucket"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "http.requests",
              "http.server_errors",
              "readiness.failures"
            ]
          },
          "bucket": {
            "type": "string",
            "enum": [
              "0",
              "1",
              "2-4",
              "5-15",
              "16-63",
              "64+"
            ]
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "signature",
              "bucket",
              "frames"
            ],
            "properties": {
              "code": {
                "const": "dependency.unavailable"
              },
              "signature": {
                "const": "http.required_dependency_unavailable.v1"
              },
              "bucket": {
                "type": "string",
                "enum": [
                  "0",
                  "1",
                  "2-4",
                  "5-15",
                  "16-63",
                  "64+"
                ]
              },
              "frames": {
                "type": "array",
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "amos.health.serve_http.v1"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "signature",
              "bucket",
              "frames"
            ],
            "properties": {
              "code": {
                "const": "handler.panic"
              },
              "signature": {
                "const": "http.handler_panic.v1"
              },
              "bucket": {
                "type": "string",
                "enum": [
                  "0",
                  "1",
                  "2-4",
                  "5-15",
                  "16-63",
                  "64+"
                ]
              },
              "frames": {
                "type": "array",
                "maxItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "amos.health.serve_http.v1"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
